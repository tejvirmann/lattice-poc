# Lattice configuration
# Copy to .env and fill in values

# ── Provider ──────────────────────────────────────────────────
# "ollama"      → local model, data never leaves the server (production)
# "openrouter"  → cloud inference, data goes to provider API (dev only)
PROVIDER=ollama

# ── Ollama (local model) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Recommended production model (fits in ~20GB RAM, MoE):
# OLLAMA_MODEL=qwen3:30b-a3b

# ── OpenRouter (dev / cloud fallback) ─────────────────────────
# PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ── Open WebUI ────────────────────────────────────────────────
OPENWEBUI_PORT=4000
OPENWEBUI_URL=http://localhost:4000
# API key — leave empty to auto sign-in with admin credentials below
OPENWEBUI_API_KEY=
# Admin credentials used when WEBUI_AUTH=False (defaults match Open WebUI's first-run defaults)
OPENWEBUI_ADMIN_EMAIL=admin@localhost
OPENWEBUI_ADMIN_PASSWORD=admin
# Base model ID as Open WebUI knows it (overrides OLLAMA_MODEL for preset creation)
# OPENWEBUI_BASE_MODEL=qwen3:8b
# URL Open WebUI uses to reach MCPO (inside Docker → host.docker.internal)
# OPENWEBUI_MCPO_URL=http://host.docker.internal:8001

# ── MCPO (MCP → HTTP/SSE proxy) ───────────────────────────────
MCPO_PORT=8001

# ── OpenCode (alternative harness) ────────────────────────────
# HARNESS=opencode   # set to "opencode" to use opencode web instead of Open WebUI
# OPENCODE_PORT=4000

# ── Lattice Manager ────────────────────────────────────────────
MANAGER_PORT=5000
