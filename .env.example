# Lattice configuration
# Copy to .env and fill in values

# ── Provider ──────────────────────────────────────────────────
# "ollama"      → local model, data never leaves the server (production)
# "openrouter"  → cloud inference, data goes to provider API (dev only)
PROVIDER=ollama

# ── Ollama (local model) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Recommended production model (fits in ~20GB RAM, MoE):
# OLLAMA_MODEL=qwen3:30b-a3b

# ── OpenRouter (dev / cloud fallback) ─────────────────────────
# PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ── OpenCode Web ───────────────────────────────────────────────
OPENCODE_PORT=4000
OPENCODE_HOSTNAME=0.0.0.0
# OPENCODE_WEB_PASSWORD=changeme   # uncomment to require password

# ── Lattice Manager ────────────────────────────────────────────
MANAGER_PORT=5000
